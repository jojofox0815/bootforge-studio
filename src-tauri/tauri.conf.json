{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BootForge Studio",
  "version": "0.1.0",
  "identifier": "studio.bootforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{ "title": "BootForge Studio", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  }
}
